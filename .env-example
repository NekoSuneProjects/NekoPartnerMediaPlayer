# Server
PORT=3000

SECRET_KEY=RANDOMHASHHERE
YTDLP_API=http://localhost:3000

# CORS (for /api/* routes)
# - Default behavior if unset: allow any origin (Access-Control-Allow-Origin: *)
# - If you need cookies/credentials: set CORS_ALLOW_CREDENTIALS=true and provide explicit origins
# CORS_ALLOW_ORIGINS=*
# CORS_ALLOW_ORIGINS=https://example.com,https://another.example
# CORS_ALLOW_CREDENTIALS=false

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REDISPASS
REDIS_DB=0

DB_TYPE=sqlite         # or: postgres or sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=DBHERE

# DB connection tuning (mainly for MySQL/MariaDB)
# DB_CONNECT_TIMEOUT_MS=10000
# DB_POOL_MAX=5
# DB_POOL_MIN=0
# DB_POOL_ACQUIRE_MS=30000
# DB_POOL_IDLE_MS=10000
# DB_SEQUELIZE_RETRY_MAX=3
# DB_RETRY_BASE_DELAY_MS=1000
# DB_RETRY_MAX_DELAY_MS=30000

# For SQLite (used only if DB_TYPE is sqlite)
SQLITE_STORAGE=./db.sqlite
